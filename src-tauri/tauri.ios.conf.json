{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.eightxt.compass",
  "build": {
    "beforeDevCommand": "pnpm exec vite --config vite.config.ts",
    "beforeBuildCommand": "pnpm exec vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compass",
        "backgroundColor": [0, 0, 0, 255]
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "externalBin": [],
    "fileAssociations": [],
    "resources": [],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "updater": null
  }
}
